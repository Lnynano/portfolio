---
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description: string;
  /** Path relative to the site root, e.g. "cv". */
  path?: string;
}

const { title, description, path = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const site = Astro.site ?? new URL('https://lnynano.com');
const canonical = new URL(base + path, site).href;
const ogImage = new URL(base + 'og.png', site).href;
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={base + 'favicon.svg'} type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0c" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${profile.handle} · ${profile.name}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} (${profile.handle})`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="th_TH" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Apply saved theme/language before paint to avoid a flash. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const theme = localStorage.getItem('theme');
          if (theme === 'light') root.classList.add('light');
          const lang = localStorage.getItem('lang');
          if (lang === 'en' || lang === 'th') {
            root.lang = lang;
            root.dataset.lang = lang;
          }
        } catch {}
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-bg text-fg antialiased">
    <slot />
  </body>
</html>
