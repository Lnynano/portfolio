---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import T from '../components/T.astro';
import { profile, bare } from '../data/profile';
import { ui } from '../i18n/ui';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const en = (t: typeof profile.pitch) => (typeof t === 'string' ? t : t.en);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const liveCount = profile.projects.filter((p) => p.isLive).length;
const startYear = (() => {
  const p = profile.education[0]?.period;
  const s = typeof p === 'string' ? p : p?.en ?? '';
  return s.match(/\d{4}/)?.[0] ?? '';
})();
---

<Base title={`${profile.name} (${profile.handle})`} description={`${en(profile.title)}. ${en(profile.pitch)}`}>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-10 focus:rounded-md focus:bg-fg focus:px-3 focus:py-2 focus:text-bg">
    Skip to content
  </a>
  <Header />

  <main id="main">
    <!-- Hero -->
    <section class="mx-auto grid max-w-6xl items-center gap-14 px-5 pt-16 pb-20 sm:px-8 sm:pt-24 lg:grid-cols-[1.1fr_1fr]" aria-labelledby="hero-title">
      <div class="flex flex-col gap-6">
        {
          profile.status && (
            <p class="inline-flex items-center gap-2.5 self-start rounded-full border border-line-strong px-3.5 py-1.5 font-mono text-[13px] text-muted">
              <span class="size-2 rounded-full bg-accent" aria-hidden="true" />
              <T t={profile.status} />
            </p>
          )
        }
        <h1 id="hero-title" class="text-[2.6rem] leading-[1.04] font-bold tracking-tight text-balance sm:text-6xl">
          {profile.name}{' '}
          <span class="text-purple-ink">({profile.handle})</span>
        </h1>
        <p class="max-w-[32ch] text-xl leading-snug text-balance sm:text-2xl">
          <T t={profile.pitch} />
        </p>
        <p class="text-muted"><T t={profile.title} /></p>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a href="#projects" class="inline-flex min-h-[46px] items-center rounded-full bg-accent px-6 font-semibold text-on-accent transition-opacity hover:opacity-90">
            <T t={ui.seeWork} />&nbsp;<span aria-hidden="true">↓</span>
          </a>
          <a href={`${base}cv`} class="inline-flex min-h-[46px] items-center rounded-full border border-line-strong px-6 font-semibold transition-colors hover:border-fg">
            <T t={ui.viewCv} />&nbsp;<span aria-hidden="true">→</span>
          </a>
          <a href={profile.github} target="_blank" rel="noopener me" aria-label="GitHub" class="inline-flex size-[46px] items-center justify-center rounded-full border border-line-strong transition-colors hover:border-fg">
            <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-.9-2.6c3.1-.3 6.4-1.5 6.4-7a5.4 5.4 0 0 0-1.5-3.7 5 5 0 0 0-.1-3.8s-1.2-.3-3.9 1.5a13.4 13.4 0 0 0-7 0C6.3 1.7 5.1 2 5.1 2a5 5 0 0 0-.1 3.8A5.4 5.4 0 0 0 3.5 9.5c0 5.4 3.3 6.6 6.4 7a3.4 3.4 0 0 0-.9 2.6V23"></path></svg>
          </a>
          <a href={`mailto:${profile.email}`} aria-label="Email" class="inline-flex size-[46px] items-center justify-center rounded-full border border-line-strong transition-colors hover:border-fg">
            <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>
          </a>
        </div>
      </div>

      <div class="glow overflow-hidden rounded-2xl border bg-surface" aria-hidden="true">
        <div class="flex items-center gap-2 border-b border-line px-[18px] py-3.5">
          <span class="size-2.5 rounded-full bg-line-strong"></span>
          <span class="size-2.5 rounded-full bg-line-strong"></span>
          <span class="size-2.5 rounded-full bg-line-strong"></span>
          <span class="ml-2.5 font-mono text-xs text-faint">~/{profile.handle.toLowerCase()} — zsh</span>
        </div>
        <div class="overflow-x-auto px-4 py-5 sm:px-6 sm:py-6 font-mono text-[12px] leading-[1.95] whitespace-pre sm:text-[14px] text-body">
          <div class="text-faint">$ {profile.handle.toLowerCase()} --status</div>
          <div>role      CPE student, year {profile.year}</div>
          <div>focus     web · data · AI tools</div>
          <div>stack     Python · JavaScript · Supabase</div>
          <div>speaks    ไทย / English</div>
          <div class="pt-2.5 text-faint">$ ls ~/shipped</div>
          <div>{profile.projects.map((p) => <span class="mr-4 text-accent-ink">{slug(p.name)}/</span>)}</div>
          <div class="text-faint">{profile.moreProjects.map((p) => <span class="mr-4">{slug(p.name)}/</span>)}</div>
          <div class="pt-2.5 text-faint">$ <span class="blink inline-block h-4 w-[9px] translate-y-[3px] bg-accent"></span></div>
        </div>
      </div>
    </section>

    <!-- At a glance -->
    <section aria-label="At a glance" class="border-y border-line">
      <dl class="mx-auto grid max-w-6xl grid-cols-2 lg:grid-cols-4">
        <div class="flex flex-col-reverse gap-1 px-5 py-7 sm:px-8">
          <dt class="text-sm text-muted"><T t={ui.glanceLive} /></dt>
          <dd class="text-3xl font-bold">{liveCount}</dd>
        </div>
        <div class="flex flex-col-reverse gap-1 border-l border-line px-5 py-7 sm:px-8">
          <dt class="text-sm text-muted"><T t={ui.glanceLang} /></dt>
          <dd class="text-3xl font-bold">TH / EN</dd>
        </div>
        <div class="flex flex-col-reverse gap-1 border-t border-line px-5 py-7 sm:px-8 lg:border-t-0 lg:border-l">
          <dt class="text-sm text-muted"><T t={ui.glanceStudy} /></dt>
          <dd class="text-3xl font-bold">{startYear} →</dd>
        </div>
        <div class="flex flex-col-reverse gap-1 border-t border-l border-line px-5 py-7 sm:px-8 lg:border-t-0">
          <dt class="text-sm text-muted"><T t={ui.glanceWork} /></dt>
          <dd class="text-3xl font-bold">Jul 2024 →</dd>
        </div>
      </dl>
    </section>

    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <Section id="projects" title={ui.projects} index={1}>
        <div class="flex flex-col gap-8">
          {profile.projects.map((p) => <ProjectCard project={p} />)}
          <div class="grid gap-5 md:grid-cols-2">
            {
              profile.moreProjects.map((p) => (
                <a href={p.code} target="_blank" rel="noopener" class="group flex flex-col gap-2.5 rounded-2xl border border-line bg-surface p-6 transition-colors hover:border-purple">
                  <span class="font-mono text-xs text-faint uppercase"><T t={p.tag} /></span>
                  <span class="text-xl font-semibold">
                    {p.name} <span aria-hidden="true" class="text-faint transition-colors group-hover:text-accent-ink">↗</span>
                  </span>
                  <span class="text-[0.95rem] text-muted"><T t={p.description} /></span>
                  <span class="font-mono text-xs text-faint">{p.stack.join(' · ')}</span>
                </a>
              ))
            }
          </div>
        </div>
      </Section>

      <Section id="skills" title={ui.skills} index={2} class="border-t border-line">
        <dl class="grid gap-4 md:grid-cols-2">
          {
            profile.skills.map((g) => (
              <div class="flex flex-col gap-3.5 rounded-2xl border border-line p-6">
                <dt class="font-mono text-xs text-faint uppercase"><T t={g.label} /></dt>
                <dd>
                  <ul class="flex flex-wrap gap-2 text-sm">
                    {g.items.map((s) => (
                      <li class:list={['rounded-full px-3 py-1.5', /learning/i.test(s) ? 'bg-surface-2/60 text-muted' : 'bg-surface-2']}>{s}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </Section>

      <div class="grid gap-x-14 border-t border-line lg:grid-cols-2">
        <Section id="experience" title={ui.experience} index={3}>
          <ol class="flex flex-col gap-8 border-l border-line-strong pl-6">
            {
              profile.experience.map((e, i) => (
                <li class="flex flex-col gap-1.5">
                  {e.period && (
                    <p class:list={['font-mono text-xs font-medium uppercase', i === 0 ? 'text-accent-ink' : 'text-faint']}>
                      <T t={e.period} />
                    </p>
                  )}
                  <h3 class="text-lg font-semibold"><T t={e.role} /></h3>
                  <p class="text-[0.95rem] text-muted"><T t={e.org} /></p>
                  {e.details && <p class="text-[0.95rem] text-body"><T t={e.details} /></p>}
                </li>
              ))
            }
          </ol>
        </Section>

        <Section id="education" title={ui.education} index={4}>
          <ul class="flex flex-col gap-4">
            {
              profile.education.map((ed) => (
                <li class="flex flex-col gap-2 rounded-2xl border border-line bg-surface p-6">
                  <p class="font-mono text-xs text-faint uppercase"><T t={ed.period} /></p>
                  <h3 class="text-xl font-semibold"><T t={ed.degree} /></h3>
                  <p class="text-[0.95rem] text-muted"><T t={ed.school} /></p>
                  {profile.courses.length > 0 && (
                    <ul class="flex flex-wrap gap-2 pt-3" aria-label="Relevant coursework">
                      {profile.courses.map((c) => (
                        <li class="rounded-md border border-line-strong px-2.5 py-1 font-mono text-xs text-body">{c}</li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }
          </ul>
        </Section>
      </div>
    </div>

    <div class="hazard hazard-accent" aria-hidden="true"></div>

    <!-- Contact -->
    <section id="contact" aria-labelledby="contact-title" class="mx-auto flex max-w-6xl flex-col gap-6 px-5 pt-20 pb-6 sm:px-8 sm:pt-24">
      <h2 id="contact-title" class="max-w-[16ch] text-4xl leading-[1.08] font-bold tracking-tight text-balance sm:text-5xl">
        <T t={ui.contactTitle} />
      </h2>
      <p class="text-lg text-muted"><T t={ui.contactSub} /></p>
      <a href={`mailto:${profile.email}`} class="self-start border-b-2 border-accent-ink pb-1 text-2xl font-semibold break-all text-accent-ink sm:text-[1.75rem]">
        {profile.email} <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>

  <footer class="mx-auto mt-12 max-w-6xl border-t border-line px-5 py-8 text-sm text-muted sm:px-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {profile.name}</p>
      <ul class="flex gap-5">
        <li><a class="link" href={profile.github} target="_blank" rel="noopener">GitHub</a></li>
        <li><a class="link" href={profile.instagram} target="_blank" rel="noopener">Instagram</a></li>
        <li><a class="link" href={`${base}cv`}><T t={ui.cv} /></a></li>
      </ul>
    </div>
  </footer>
</Base>
