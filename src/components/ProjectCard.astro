---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { Project } from '../data/profile';
import { ui } from '../i18n/ui';
import T from './T.astro';
import LiveBadge from './LiveBadge.astro';
import ScoreboardPreview from './ScoreboardPreview.astro';
import BillPreview from './BillPreview.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// A real screenshot in /public wins; otherwise the drawn preview; otherwise initials.
const hasImage = !!project.image && existsSync(join(process.cwd(), 'public', project.image));
const initials = project.name
  .split(/\s+/)
  .map((w) => w[0])
  .join('')
  .slice(0, 3);
---

<article class="grid overflow-hidden rounded-[20px] border border-line bg-surface md:grid-cols-2">
  <div class="flex flex-col gap-4 p-7 sm:p-9">
    <div class="flex flex-wrap items-center gap-2.5 font-mono text-xs font-medium uppercase">
      {project.tag && <span class="text-accent-ink"><T t={project.tag} /></span>}
      {project.isLive && <span class="text-line-strong" aria-hidden="true">/</span>}
      {project.isLive && <LiveBadge />}
    </div>
    <h3 class="text-[1.9rem] leading-tight font-bold tracking-tight">{project.name}</h3>
    <p class="text-body"><T t={project.description} /></p>

    <ul class="flex flex-wrap gap-2" aria-label="Tech stack">
      {project.stack.map((s) => <li class="rounded-md border border-line-strong px-2.5 py-1 font-mono text-xs text-body">{s}</li>)}
    </ul>

    <div class="mt-auto flex flex-wrap gap-5 pt-2 text-[0.95rem] font-semibold">
      {
        project.live && (
          <a href={project.live} class="link inline-flex items-center gap-1" target="_blank" rel="noopener">
            <T t={ui.openLive} />
            <span aria-hidden="true">↗</span>
            <span class="sr-only">: {project.name} (opens in new tab)</span>
          </a>
        )
      }
      {
        project.code && (
          <a href={project.code} class="link inline-flex items-center gap-1 text-muted" target="_blank" rel="noopener">
            <T t={ui.code} />
            <span aria-hidden="true">↗</span>
            <span class="sr-only">: {project.name} on GitHub (opens in new tab)</span>
          </a>
        )
      }
    </div>
  </div>

  <div class="relative flex min-h-[320px] items-center justify-center border-t border-line bg-sunken p-8 md:border-t-0 md:border-l">
    {
      hasImage ? (
        <img
          src={base + project.image!.replace(/^\//, '')}
          alt={`Screenshot of ${project.name}`}
          width="1280"
          height="800"
          loading="lazy"
          decoding="async"
          class="w-full rounded-xl border border-line object-cover object-top"
        />
      ) : project.preview === 'scoreboard' ? (
        <ScoreboardPreview />
      ) : project.preview === 'bills' ? (
        <BillPreview />
      ) : (
        <span class="font-mono text-3xl font-semibold text-muted" aria-label={`${project.name}: screenshot coming soon`}>
          {initials}
        </span>
      )
    }
    {
      !hasImage && project.preview && (
        <span class="absolute right-4 bottom-3 font-mono text-[10px] text-faint">
          <T t={ui.previewNote} />
        </span>
      )
    }
  </div>
</article>
