---
// Drawn preview of Normalday's electric bill tool. Sample input only.
---

<div aria-hidden="true" class="flex w-[220px] flex-col gap-3 rounded-[28px] border border-line bg-surface px-4 py-[18px]">
  <div class="flex items-center justify-between">
    <span class="text-[15px] font-semibold">Electric Bill</span>
    <span class="rounded-full border border-line-strong px-2 py-0.5 font-mono text-[10px] text-faint">MEA</span>
  </div>
  <div class="flex flex-col gap-1 rounded-xl bg-surface-2 p-3">
    <span class="text-[11px] text-faint">Usage</span>
    <span class="font-mono text-[22px] font-medium">250 <span class="text-[13px] text-faint">kWh</span></span>
  </div>
  <div class="flex flex-col gap-1.5 font-mono text-[11px] text-muted">
    <div class="flex justify-between"><span>Energy</span><span>tiered</span></div>
    <div class="flex justify-between"><span>Ft + service</span><span>incl.</span></div>
    <div class="flex justify-between"><span>VAT 7%</span><span>incl.</span></div>
  </div>
  <div class="flex items-baseline justify-between rounded-xl bg-accent p-3 text-on-accent">
    <span class="text-xs font-semibold">Total</span>
    <span class="font-mono text-xl font-semibold">฿ ——</span>
  </div>
  <div class="grid grid-cols-3 gap-1.5 text-center text-[10px] text-muted">
    <span class="rounded-lg bg-surface-2 py-1.5">Laundry</span>
    <span class="rounded-lg bg-purple-soft py-1.5 text-fg">Electric</span>
    <span class="rounded-lg bg-surface-2 py-1.5">Split</span>
  </div>
</div>
