---
import type { Text } from '../data/profile';
import T from './T.astro';

interface Props {
  id: string;
  title: Text;
  index: number;
  class?: string;
}

const { id, title, index, class: className = '' } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class:list={['scroll-mt-8 py-16 sm:py-24', className]}>
  <h2 id={`${id}-title`} class="mb-10 flex items-baseline gap-4 text-3xl font-bold tracking-tight sm:text-4xl">
    <span class="font-mono text-sm font-medium text-purple-ink" aria-hidden="true">{String(index).padStart(2, '0')}</span>
    <T t={title} />
  </h2>
  <slot />
</section>
